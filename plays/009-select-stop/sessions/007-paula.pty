0;0m 28 +                                                                                                                                                                   [K[m            [38;2;80;200;80m[48;2;2;40;0m 29 +[38;2;248;248;242mAt any moment the screen follows **one stop**, the *shown stop*. The sheet, the red stop marker,                                                                   [K[m            [38;2;80;200;80m[48;2;2;40;0m 30 +[38;2;248;248;242mthe bus countdowns and dimming, the direction filter and smart zoom all follow it. It is the stop                                                                  [K[m            [38;2;80;200;80m[48;2;2;40;0m 31 +[38;2;248;248;242mthe user tapped (the **selected stop**) if there is one, and otherwise the **nearest stop**                                                                        [K[m            [38;2;80;200;80m[48;2;2;40;0m 32 +[38;2;248;248;242m(`nearestStop(network.stops, position)`, which exists only while located). In `App.tsx`:                                                                           [K[m            [38;2;80;200;80m[48;2;2;40;0m 33 +                                                                                                                                                                   [K[m            [38;2;80;200;80m[48;2;2;40;0m 34 +[38;2;248;248;242m- `selectedStopId` holds the tapped stop by **id**, so a network refresh cannot leave a stale                                                                      [K[m            [38;2;80;200;80m[48;2;2;40;0m 35 +  [38;2;248;248;242mobject behind. It is not persisted, just like `sheetCollapsed`.                                                                                                  [K[m            [38;2;80;200;80m[48;2;2;40;0m 36 +[38;2;248;248;242m- `selected` is that stop looked up in `stopsById`. It is `null` when the id is the nearest                                                                        [K[m            [38;2;80;200;80m[48;2;2;40;0m 37 +  [38;2;248;248;242mstop's id, so a selected stop that is (or becomes) the nearest one is shown as the nearest                                                                       [K[m            [38;2;80;200;80m[48;2;2;40;0m 38 +  [38;2;248;248;242mstop, with its "Nearest stop" labels. It is also `null` when a refresh drops the stop, and the                                                                   [K[m            [38;2;80;200;80m[48;2;2;40;0m 39 +  [38;2;248;248;242mapp falls back to the nearest stop.                                                                                                                              [K[m            [38;2;80;200;80m[48;2;2;40;0m 40 +[38;2;248;248;242m- `stop = selected ?? nearest?.stop ?? null`. With no location and nothing selected, no stop is                                                                    [K[m            [38;2;80;200;80m[48;2;2;40;0m 41 +  [38;2;248;248;242mshown.                                                                                                                                                           [K[m            [38;2;80;200;80m[48;2;2;40;0m 42 +                                                                                                                                                                   [K[m            [38;2;80;200;80m[48;2;2;40;0m 43 +[38;2;248;248;242m### Selecting a stop                                                                                                                                               [K[m            [38;2;80;200;80m[48;2;2;40;0m 44 +                                                                                                                                                                   [K[m            [38;2;80;200;80m[48;2;2;40;0m 45 +[38;2;248;248;242m- **Hit test** (`stopIdAt` in `MapView.tsx`). A click or tap on the map canvas picks a stop whose                                                                  [K[m            [38;2;80;200;80m[48;2;2;40;0m 46 +  [38;2;248;248;242mwhite circle (the `stops` layer) is within **16 px** of the pointer (`STOP_HIT_RADIUS_PX`, a[69X[38;2;80;200;80m[33;6H 47 +  [38;2;248;248;242m32 px target around a circle about 13 px across). The rendered-features query box is square, so[66X[38;2;80;200;80m[34;6H 48 +  [38;2;248;248;242mcandidates are also filtered by their projected pixel distance to keep the target round. When[68X[m[35;3H   [38;2;80;200;80m[48;2;2;40;0m 49 +  [38;2;248;248;242mseveral stops are in range (for example an asc/desc pair), the one closest to the tapped point[67X[38;2;80;200;80m[36;6H 50 +  [38;2;248;248;242mwins, through the domain `nearestStop` and its lower-id tie rule. Before the network has loaded,[65X[m
